{
  "name": "chido.casino",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "npm run lock:verify && npm run test && npm run lint && npm run typecheck && npm run audit:prod",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "lock:verify": "git diff --exit-code -- package-lock.json",
    "lint": "eslint . --quiet",
    "lint:all": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "verify": "npm run lock:verify && npm run test && npm run lint && npm run typecheck && npm run audit:prod"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.112.2",
    "clsx": "^2.1.1",
    "framer-motion": "^11.0.0",
    "langfuse-node": "3.38.20",
    "lucide-react": "^0.451.0",
    "next": "16.4.6",
    "node-cron": "^4.2.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.5",
    "sonner": "^2.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.6",
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.6",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "axios": "1.21.1",
    "brace-expansion": "1.1.21",
    "form-data": "4.0.6",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.20",
    "postcss": "8.5.28",
    "sharp": "0.35.5",
    "ws": "8.21.1",
    "follow-redirects": "1.16.3",
    "source-map-js": "1.2.2",
    "postcss-selector-parser": "6.1.5",
    "browserslist": "4.29.5",
    "baseline-browser-mapping": "2.11.37",
    "minimatch": {
      ".": "11.0.8",
      "brace-expansion": "5.0.13"
    }
  }
